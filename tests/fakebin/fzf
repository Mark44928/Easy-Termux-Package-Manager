#!/usr/bin/env bash
# fake fzf — answers selections from FZF_QUEUE (plain lines, one per answer),
# mirroring the fake-gum queue protocol. A line starting with "MULTI:" is
# space-split into a multi-line answer (fzf -m). With no queue (or an empty one
# after popping) it aborts like a real fzf user pressing ESC, which makes the
# app fall back to the typed/numeric prompts.
LOG="${FZF_CALL_LOG:-/dev/null}"

# Real-fzf parity for feature probes: --version (ghost probe) and --help
# (flag-capability probe in fzf_select) must neither pop the queue nor need
# one, or the probed features would stay disabled for the whole suite.
case "$1" in
    --version) printf '0.61.0 (Go)\n' ;; # keep >= the ghost floor (0.61)
    --help) printf '%s\n' '--highlight-line   Highlight the whole current line' \
                     '--scrollbar[=C1[C2]] Scrollbar character(s)' \
                     '--accept-nth=N        Define which fields to print on accept' ;;
    *) ;;
esac
if [ -n "$FAKE_FZF_FAIL" ]; then
    # full failure (like fzf exiting 2 on a dead terminal): no queue consumed,
    # exit 2 immediately — exercises the fzf-broken fallback path
    exit 2
fi
case "$1" in --version|--help) exit 0 ;; esac

printf 'fzf %s\n' "$*" >> "$LOG"

Q="${FZF_QUEUE:-}"
if [ -n "$Q" ] && [ -s "$Q" ]; then
    line=$(sed -n '1p' "$Q")
    if [ -n "$line" ]; then
        sed -n '2,$p' "$Q" > "$Q.tmp" && mv -f "$Q.tmp" "$Q"
        case "$line" in
            MULTI:*) printf '%s\n' "${line#MULTI:}" | tr ' ' '\n' ;;
            *)       printf '%s\n' "$line" ;;
        esac
        exit 0
    fi
fi
# no queued answer = ESC
exit 1
