#!/data/data/com.termux/files/usr/bin/bash
# fake dpkg
if [ "$1" = "--audit" ]; then
    exit 0
fi
if [ "$1" = "-L" ]; then
    if [ "$2" = "invalidpkg" ]; then
        exit 1
    fi
    echo "/."
    echo "/data/data/com.termux/files/usr/bin/$2"
    exit 0
fi
if [ "$1" = "-S" ]; then
    arg="$2"
    [ "$arg" = "--" ] && arg="$3"
    case "$arg" in
        *nope*) exit 1 ;;
    esac
    echo "python3: $arg"
    exit 0
fi
if [ "$1" = "-i" ]; then
    arg="$2"
    [ "$arg" = "--" ] && arg="$3"
    if [[ "$arg" == *invalidpkg* ]]; then echo "dpkg: error processing $arg" >&2; exit 1; fi
    echo "Selecting previously unselected package $arg"
    echo "Unpacking $arg"
    echo "Setting up $arg"
    exit 0
fi
if [ "$1" = "-l" ]; then
    echo "ii  python3  3.12  arm64  interpreter for Python 3"
    exit 0
fi
exit 1
