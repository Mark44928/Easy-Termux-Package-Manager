#!/usr/bin/env bash
# fake dpkg-query
# -f='${Version}' <pkg>  → installed version of one package
# -W <pkg> / -W         → "size<TAB>name" listing (stats)
fmt=""
pkg=""
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
    case "${args[$i]}" in
        -f=*) fmt="${args[$i]}" ;;
        -W) : ;;
        *) pkg="${args[$i]}" ;;
    esac
    i=$((i+1))
done

if [ -n "$fmt" ]; then
    if printf '%s' "$fmt" | grep -Fq "\${Status}"; then
        printf 'install ok installed\tpython3=3.12\ninstall ok installed\tgit=2.40.0\nconfig-files\tremoved-but-config=1.0\n'
        exit 0
    fi
    if printf '%s' "$fmt" | grep -Fq "\${Package}=\${Version}"; then
        printf 'python3=3.12\ngit=2.40.0\n'
        exit 0
    fi
    case "$fmt" in
        *Installed-Size*)
            printf '1024\tpython3\n2048\tgit\n'
            exit 0
            ;;
        *Package*)
            # manager.sh reads the full installed list with -f='${Package}\n'
            printf 'python3\ngit\n'
            exit 0
            ;;
    esac
    case "$pkg" in
        python3) echo "3.12" ;;
        git) echo "2.40.0" ;;
        invalidpkg) exit 1 ;;
        *) echo "1.0" ;;
    esac
    exit 0
fi
printf '1024\tpython3\n2048\tgit\n'
exit 0
