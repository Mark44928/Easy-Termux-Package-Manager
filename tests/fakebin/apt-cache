#!/usr/bin/env bash
# fake apt-cache
sub="$1"
shift
pkg="$1"

case "$sub" in
    show)
        if [ "$pkg" = "invalidpkg" ]; then
            echo "E: No packages found" >&2
            exit 100
        fi
        echo "Package: $pkg"
        echo "Version: 3.12"
        echo "Size: 102400"
        echo "Installed-Size: 2048"
        exit 0
        ;;
    depends)
        case "$pkg" in
            python3)
                echo "python3"
                echo "  Depends: libc"
                echo "    Depends: termux-exec"
                echo "  Depends: python-pip"
                echo "  Recommends: git"
                ;;
            libc)
                echo "libc"
                echo "  Depends: termux-exec"
                ;;
            termux-exec)
                echo "termux-exec"
                echo "  Depends: libc"
                ;;
            python-pip)
                echo "python-pip"
                ;;
            git)
                echo "git"
                ;;
            *)
                echo "$pkg"
                echo "  Depends: none"
                ;;
        esac
        exit 0
        ;;
    madison)
        if [ "$pkg" = "invalidpkg" ]; then echo "E: No packages found" >&2; exit 100; fi
        if [ -z "$FAKE_MADISON_EMPTY" ]; then
            echo " $pkg | 3.12 | https://packages.termux.dev stable/main arm64 Packages"
            echo " $pkg | 3.11 | https://packages.termux.dev stable/main arm64 Packages"
            echo " $pkg | 3.10 | https://packages.termux.dev stable/main arm64 Packages"
        fi
        exit 0
        ;;
    policy)
        if [ "$pkg" = "invalidpkg" ]; then echo "E: Unable to locate package invalidpkg" >&2; exit 100; fi
        echo "$pkg:"
        echo "  Installed: 3.12"
        echo "  Candidate: 3.12"
        echo "  Version table:"
        echo " *** 3.12 500"
        echo "        500 https://packages.termux.dev stable/main arm64 Packages"
        echo " *** 3.11 100"
        echo "        100 /data/data/com.termux/files/usr/var/lib/dpkg/status"
        exit 0
        ;;
    search)
        # install candidates must NOT be in the fake dpkg installed set
        # (python3/git are installed there, so they no longer belong in the
        # install list — installed packages are filtered out now).
        case "$pkg" in
            *python*) echo "python-tool - extra python tooling" ;;
        esac
        echo "figlet - display large characters made of ordinary screen characters"
        echo "bat - a cat clone with wings"
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
